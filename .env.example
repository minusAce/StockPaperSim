# Copy to .env and fill in your own credentials.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
PAPER_TRADING=true
ALPACA_DATA_FEED=iex

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_DEFAULT=nvidia/nemotron-3-ultra-550b-a55b:free
# Single fallback model, tried only after the primary model (a per-agent
# override below, or else MODEL_DEFAULT) has exhausted its own
# retry attempts. Leave blank, or set equal to MODEL_DEFAULT, to
# disable fallback and just retry the primary model. Must be a free OpenRouter
# model ID (":free" suffix, or "openrouter/free"). This does NOT bypass
# OpenRouter account-level request limits.
MODEL_FALLBACK=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_DAILY_REQUEST_BUDGET=50
LLM_MIN_REQUEST_INTERVAL_SECONDS=3.0
SITE_URL=http://localhost:8000
SITE_NAME=StockPaperSim

# Optional per-agent overrides. Leave blank to use MODEL_DEFAULT for
# that agent. An agent with its own override here still gets MODEL_FALLBACK
# as its safety net if the override ever fails.
MODEL_SCOUT=
MODEL_QUANT=
MODEL_MACRO=
MODEL_NEWS=
MODEL_FINANCE=
MODEL_RISK=
MODEL_PM=

TRADING_ENABLED=true
START_AUTOPILOT=false
# When true, the engine auto-activates the kill switch and shuts down the whole
# Docker stack (postgres + app) once it's past 4pm ET on a weekday, any time of
# year — including immediately after a fresh `docker compose up`. Set to false
# during local development/testing so builds don't self-terminate outside
# market hours.
MARKET_HOURS_ONLY=false
# Safe boot state: controls reset to autopilot OFF, pause OFF, kill switch OFF on app start.
RESET_RUNTIME_CONTROLS_ON_START=true
BENCHMARK_SYMBOL=^GSPC

SCANNER_INTERVAL_SECONDS=60
 # AI scheduling uses five evenly distributed waves across the regular session (10 requests per wave); OpenRouter remains authoritative for quota exhaustion.
ANALYSIS_COOLDOWN_SECONDS=0
ANALYSIS_CANDIDATES=2
SCANNER_TOP=80
# S&P 500 membership is fetched dynamically; no ticker list is hardcoded.
SP500_SOURCE_URL=https://en.wikipedia.org/wiki/List_of_S%26P_500_companies
SP500_REFRESH_HOURS=24
STREAM_SYMBOL_LIMIT=30
EVENT_TRIGGER_PCT=1.25
EVENT_TRIGGER_VOLUME_RATIO=3.0
MIN_SCAN_SCORE=4.0

MAX_POSITION_WEIGHT=0.10
MAX_ORDER_NOTIONAL=5000
MAX_DAILY_LOSS_PCT=0.1
EMERGENCY_DAILY_LOSS_PCT=.2
MAX_TOTAL_OPEN_ORDERS=10
MAX_SYMBOL_ORDERS_PER_HOUR=3
MIN_CONFIDENCE=0.65
MIN_LIQUIDITY_DOLLARS=250000
MIN_ORDER_NOTIONAL=25
MIN_ORDER_QTY=1.0

DATABASE_URL=postgresql+psycopg://trading:trading@localhost:5432/trading_floor

HISTORY_BARS=180
CHART_BARS=120
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

AI_CYCLES_PER_SESSION=5

ACTIVITY_TARGET_ENTRIES=4
